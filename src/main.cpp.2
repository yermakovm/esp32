#include <Arduino.h>

#define BTN_PIN 5
static int btnPressCounter = 0;
static int lastBtnPressTime = 0;

void handleButtonPress() {
  if (millis() - lastBtnPressTime < 200) {
    return;
  }
  lastBtnPressTime = millis();
  btnPressCounter++;
  Serial.println(btnPressCounter);
}

void setup() {
  Serial.begin(115200);
  attachInterrupt(digitalPinToInterrupt(BTN_PIN), handleButtonPress, FALLING);
}

void loop() {}
